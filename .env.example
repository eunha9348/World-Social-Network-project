# Enter server-only secrets in your deployment environment. Never use NEXT_PUBLIC_ for keys.

# Provider: `gemini` or `openai`. Left blank, GOOGLE_API_KEY selects Gemini and OPENAI_API_KEY OpenAI.
AI_PROVIDER=gemini

# Gemini via its OpenAI-compatible endpoint (Google AI Studio key).
GOOGLE_API_KEY=

# Optional. Keep an OpenAI key set even on Gemini: /moderations is free and stays the first safety
# stage. Without it the Gemini classifier fills in and shares a model with the policy check.
OPENAI_API_KEY=

# Blank uses the provider default: gemini-2.5-flash / gemini-embedding-001, or gpt-4.1-mini /
# text-embedding-3-small. Verify the ids your key can reach before deploying.
LLM_MODEL=
EMBEDDING_MODEL=

# Must match the Qdrant collection. Changing it requires a new collection and a full reindex.
EMBEDDING_DIMENSIONS=1536

# Optional Cloudflare AI Gateway base, replacing the provider base URL (caching, rate limits, spend
# analytics). Include everything up to but not including /chat/completions.
# AI_GATEWAY_URL=
# AI_GATEWAY_OPENAI_URL=

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=polylogue
INGEST_TOKEN=
ADMIN_EMAILS=
